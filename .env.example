# ČSOB Business Connector — production test credentials template
# 1. Copy this file to `.env`
# 2. Fill in your real contract number and ClientAppGuid from the CEB portal.
# 3. Adjust cert paths if they differ.
# 4. Run: set -a && source .env && uv run python test_prod.py

CSOB_CONTRACT=YOUR_CONTRACT_NUMBER_HERE
CSOB_CLIENT_APP_GUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CSOB_CERT_PEM=certs/bccert.pem
CSOB_CERT_KEY=certs/bccert.key
CSOB_WSDL=wsdl/CEBBCWS.wsdl
