<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://example.com/bc"
             targetNamespace="http://example.com/bc">
  <types>
    <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://example.com/bc">
      <element name="GetDownloadFileListRequest">
        <complexType>
          <sequence>
            <element name="ContractNumber" type="string"/>
            <element name="PrevQueryTimestamp" type="string" minOccurs="0"/>
          </sequence>
        </complexType>
      </element>
      <element name="GetDownloadFileListResponse">
        <complexType>
          <sequence>
            <element name="QueryTimestamp" type="string"/>
            <element name="FileList" minOccurs="0">
              <complexType>
                <sequence>
                  <element name="FileDetail" maxOccurs="unbounded">
                    <complexType>
                      <sequence>
                        <element name="Url" type="string" minOccurs="0"/>
                        <element name="Filename" type="string"/>
                        <element name="Type" type="string"/>
                        <element name="Format" type="string" minOccurs="0"/>
                        <element name="CreationDateTime" type="string"/>
                        <element name="Size" type="int" minOccurs="0"/>
                        <element name="UploadFileHash" type="string" minOccurs="0"/>
                        <element name="Status" type="string"/>
                      </sequence>
                    </complexType>
                  </element>
                </sequence>
              </complexType>
            </element>
          </sequence>
        </complexType>
      </element>
    </schema>
  </types>
  <message name="GetDownloadFileListRequestMessage">
    <part name="parameters" element="tns:GetDownloadFileListRequest"/>
  </message>
  <message name="GetDownloadFileListResponseMessage">
    <part name="parameters" element="tns:GetDownloadFileListResponse"/>
  </message>
  <portType name="BCPortType">
    <operation name="GetDownloadFileList">
      <input message="tns:GetDownloadFileListRequestMessage"/>
      <output message="tns:GetDownloadFileListResponseMessage"/>
    </operation>
  </portType>
  <binding name="BCBinding" type="tns:BCPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="GetDownloadFileList">
      <soap:operation soapAction="GetDownloadFileList"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="BCService">
    <port name="BCPort" binding="tns:BCBinding">
      <soap:address location="https://testceb-bc.csob.cz/cebbc/api"/>
    </port>
  </service>
</definitions>
